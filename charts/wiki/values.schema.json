{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "publicURL": {
      "type": "string",
      "pattern": "^https?://[^/?#]+(/[^?#]*)?$"
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "contentPrefix": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
    },
    "config": {
      "type": "object"
    },
    "siteConfig": {
      "type": "string"
    },
    "bootstrapSecret": {
      "type": "string"
    },
    "staticFiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
